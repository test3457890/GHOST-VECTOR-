# GHOST VECTOR CTF configuration
# Copy this file to config/flags.env and change EVERY value before an event.
# config/flags.env is ignored by git. Never commit real flags.

# Phase 1: Ghost Signal (full flags, AstroSec format)
FLAG_G1=AstroSec{CHANGE_ME_power_loss}
FLAG_G2=AstroSec{CHANGE_ME_clock_drift}
FLAG_G3=AstroSec{CHANGE_ME_thermal_whisper}

# Phase 2: Silent Vector marker codes
# Rules: CODE_V2 may only use A-Z, 0-9 and underscore (it is sent as Morse).
# Keep each code 12 to 24 characters for a fair puzzle length.
CODE_V1=NAV_CHANGEME_SYNC_1
CODE_V2=NAV_CHANGEME_VECTOR_2
CODE_V3=NAV_CHANGEME_COORD_3
CODE_V4=NAV_CHANGEME_PRIME_4

# Final stage flag. Shown on HANDSHAKE.SYS after a correct master coordinate,
# so players can submit it to CTFd. Leave blank for judge-only scoring.
FLAG_FINAL=AstroSec{CHANGE_ME_ghost_01_home}

# Final stage: SHA256 of the master coordinate (run tools/set_prize_key.py)
# Leave blank and the transmitter stays offline.
PRIZE_KEY_HASH=

# Random seed for data generation. Change it to reshuffle row positions.
SEED=1420

# gated = a Phase 1 flag unlocks Phase 2, open = Phase 2 always available
# With CTFd, use open: CTFd prerequisites already lock Phase 2.
PHASE2_GATE=open

# Public URL of this terminal, used in CTFd challenge text by tools/build_ctfd.py
TERMINAL_URL=http://localhost:8080

# Session signing key. Set a long random value for events.
SECRET_KEY=change-me-to-a-long-random-string

# Set to 1 to force new challenge data on next start
REGENERATE=0
